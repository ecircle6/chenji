# Gradle 构建缓存与产物
.gradle/
build/
app/build/

# 本地环境配置（包含本机 SDK 路径，不应共享）
local.properties

# IDE 配置（大部分是本机个人设置）
.idea/
*.iml
.kotlin/

# 本地工具与日志
.tools/
build_log.txt

# 测试过程中的临时截图
screenshot_*.png
test_*.png
review_*.png
mockup_check.png

# 签名密钥：绝不能进版本库。丢了 keystore 就无法给已装的 App 做覆盖升级，
# 所以要单独备份到网盘/U盘，但不能提交到 git。
*.jks
*.keystore
keystore.properties

