<?xml version="1.0" encoding="utf-8"?>
<!-- 长按应用图标的快捷方式：点「添加小组件」直接唤起添加流程。
     静态快捷方式（API 25+，minSdk 26 全覆盖）：系统启动 MainActivity 并带上
     com.birthapp.action.REQUEST_WIDGET，MainActivity 收到后弹桌面放置框 -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_widget"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_widget"
        android:shortcutShortLabel="@string/shortcut_add_widget"
        android:shortcutLongLabel="@string/shortcut_add_widget_long">
        <intent
            android:action="com.birthapp.action.REQUEST_WIDGET"
            android:targetPackage="com.birthapp"
            android:targetClass="com.birthapp.MainActivity" />
    </shortcut>
</shortcuts>